folder_id       = "123456789012"
billing_account = "0158ED-XXXXXX-XXXXXX"
region          = "asia-northeast1"
vertex_region   = "us-east5"

# Built and pushed after the first apply (docs/operations.md); leave unset until then.
# image = "asia-northeast1-docker.pkg.dev/milos-runtime-dev/milos/milos:<sha>"

agent_ids   = ["analyst"]
users_group = "agent-users@example.com"
admin_group = "agent-admins@example.com" # publish, enable, disable; add milos-admin@<runtime>.iam.gserviceaccount.com

# IAP assertion audience for the public Cloud Run service. Confirm on the
# first deploy (docs/operations.md, "First deploy").
iap_audience = "/projects/000000000000/locations/asia-northeast1/services/milos-api-public"

allowed_fqdns  = ["api.notion.com"]
egress_secrets = { notion-token = "NOTION_TOKEN" }

schedules = {
  weekly-numbers = {
    agent_id  = "analyst"
    message   = "Summarise last week's numbers."
    cron      = "0 9 * * 1"
    approvers = ["lead@example.com"]
  }
}

alert_email = "owner@example.com"

# access_policy_id = "987654321"
# perimeter_admins = ["group:da-gcp-admin@example.com"]
