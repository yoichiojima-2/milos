# Operator side (the `milos` CLI). Copy to .env and fill in.
MILOS_API_URL=https://milos-api-public-000000000000.asia-northeast1.run.app
# IAP OAuth client id, used as the audience of the identity token gcloud mints.
MILOS_IAP_CLIENT_ID=
# Alternatively paste a token: gcloud auth print-identity-token --audiences $MILOS_IAP_CLIENT_ID
#MILOS_ID_TOKEN=

# CI side (`milos agents publish`): direct Firestore access to the runtime project.
#MILOS_PROJECT=milos-runtime-dev

# Local API without GCP: trust this email, log audit entries to stderr, launch nothing.
#MILOS_DEV_USER=you@example.com
#MILOS_TOKEN_KEY=dev
#FIRESTORE_EMULATOR_HOST=localhost:8080
