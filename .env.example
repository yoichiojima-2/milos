# milos client-side environment. Copy to .env and fill in.
# The sandbox runner gets its environment from the Cloud Run job (Terraform),
# not from this file.

# --- required ---
# GCP project (GOOGLE_CLOUD_PROJECT works as a fallback)
MILOS_PROJECT=your-project

# --- deploy helpers (README quickstart) ---
# Runner image; also passed to terraform as -var image=$MILOS_IMAGE
MILOS_IMAGE=asia-northeast1-docker.pkg.dev/${MILOS_PROJECT}/milos/runner:latest

# --- optional overrides (defaults shown) ---
# Cloud Run region
#MILOS_REGION=asia-northeast1
# Where model calls go: vertex (in-project) or anthropic (needs the
# anthropic-api-key secret populated, terraform model_backend=anthropic,
# AND the active policy's model_backends to allow it)
#MILOS_MODEL_BACKEND=vertex
# State/evidence buckets (default: derived from the project)
#MILOS_BUCKET=${MILOS_PROJECT}-milos
#MILOS_EVIDENCE_BUCKET=${MILOS_PROJECT}-milos-evidence
# Cloud Run Job name
#MILOS_JOB=milos-runner
# Seconds an approval waits before it becomes a recorded deny
#MILOS_APPROVAL_TIMEOUT=300

# Never put ANTHROPIC_API_KEY here — it lives in Secret Manager
# (anthropic-api-key) and is mounted into the sandbox by Terraform.
